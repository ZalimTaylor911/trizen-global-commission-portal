{
  "name": "trizen-commission-portal",
  "version": "0.2.0",
  "private": true,
  "description": "Trizen Global — Freight Agent Commission & Finance Management System",
  "author": "Trizen Global",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "cross-env TRIZEN_WEB_ONLY=1 vite",
    "build": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "firebase": "^11.1.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "firebase-tools": "^15.25.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.trizenglobal.commissionportal",
    "productName": "TG Commission Portal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "icon": "src/assets/brand/sidebar_app_icon.png",
      "executableName": "TG Commission Portal",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TG Commission Portal"
    }
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.5": true,
    "@firebase/util@1.12.1": true,
    "re2@1.26.1": true
  }
}
