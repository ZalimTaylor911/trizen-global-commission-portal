# Copy this file to `.env` and fill in the values from your Firebase project.
# Firebase Console > Project settings > General > Your apps > Web app > SDK setup and configuration
#
# These values are NOT secret — a Firebase web config is safe to ship in a client
# app. Access is enforced by Firestore security rules (see firestore.rules), not
# by hiding this config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
